    <ClInclude Include="..\Runtime\GarbageCollector.h" />
  </ItemGroup>
  <ItemGroup>
    <ClCompile Include="HelloWorld.cpp" />
    <ClCompile Include="Main.cpp" />
    <ClCompile Include="..\Runtime\UClass.cpp" />
    <ClCompile Include="..\Runtime\UObject.cpp" />
    <ClCompile Include="..\Runtime\ScriptVM.cpp" />
    <ClCompile Include="..\Runtime\GarbageCollector.cpp" />
    <ClCompile Include="..\..\Intermediate\Generated\HelloWorld.gen.cpp" />
  </ItemGroup>
  <ItemGroup>
    <None Include="..\..\Development\Src\HelloWorld\Classes\HelloWorld.uc" />
    <None Include="..\..\Development\Src\HelloWorld\Classes\Greeter.uc" />
  </ItemGroup>
